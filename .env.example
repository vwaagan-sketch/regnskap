# PostgreSQL (lokalt: docker compose up -d)
DATABASE_URL=postgres://regnskap:regnskap@localhost:5432/regnskap
# Nøkkel til Claude API for tolking av kvitteringer
ANTHROPIC_API_KEY=
# Brukes bare til å opprette første bruker (administrator) når ingen brukere finnes ennå
APP_USER=vegard
APP_PASSWORD=
# Offentlig adresse, brukes i invitasjonslenker
APP_URL=http://localhost:3000
# Sett til false for å stenge selvregistrering av nye firma
ALLOW_SIGNUP=true
# Minst 32 tilfeldige tegn, f.eks. `openssl rand -base64 48`
SESSION_SECRET=
# Bilag på e-post via Postmark (se README)
INNBOKS_ADRESSE=
INNBOKS_WEBHOOK_PASSORD=
# Utgående e-post (glemt passord) via Postmark
POSTMARK_SERVER_TOKEN=
EPOST_AVSENDER=
